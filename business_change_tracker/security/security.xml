<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_business_change" model="res.groups.privilege">
        <field name="name">Change Tracker</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_business_change_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Can view the change history of the records they are allowed to read.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_business_change"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_business_change_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">Configures tracking rules and retention; also sees history of deleted records.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_business_change"/>
        <field name="implied_ids" eval="[(4, ref('group_business_change_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="business_change_log_company_rule" model="ir.rule">
        <field name="name">Change history: multi-company</field>
        <field name="model_id" ref="model_business_change_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
