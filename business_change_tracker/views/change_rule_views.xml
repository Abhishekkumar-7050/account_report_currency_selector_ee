<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="business_change_rule_view_list" model="ir.ui.view">
        <field name="name">business.change.rule.list</field>
        <field name="model">business.change.rule</field>
        <field name="arch" type="xml">
            <list string="Tracking Rules" decoration-muted="not active">
                <field name="name"/>
                <field name="model_id"/>
                <field name="field_summary"/>
                <field name="track_create" optional="show"/>
                <field name="track_unlink" optional="show"/>
                <field name="active" widget="boolean_toggle" string="Enabled"/>
            </list>
        </field>
    </record>

    <record id="business_change_rule_view_form" model="ir.ui.view">
        <field name="name">business.change.rule.form</field>
        <field name="model">business.change.rule</field>
        <field name="arch" type="xml">
            <form string="Tracking Rule">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="log_count" widget="statinfo" string="Changes"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Disabled" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sales Orders"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model_name" invisible="1"/>
                            <field name="active" widget="boolean_toggle" string="Enabled"/>
                        </group>
                        <group>
                            <field name="track_create"/>
                            <field name="track_unlink"/>
                            <field name="parent_field_id" options="{'no_create': True}" invisible="not model_id"/>
                        </group>
                    </group>
                    <field name="field_ids" invisible="not model_id" options="{'no_create': True}">
                        <list>
                            <field name="field_description" string="Field"/>
                            <field name="ttype" string="Type" optional="hide"/>
                            <field name="name" string="Technical Name" optional="hide"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="business_change_rule_view_search" model="ir.ui.view">
        <field name="name">business.change.rule.search</field>
        <field name="model">business.change.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_id"/>
                <filter name="enabled" string="Enabled" domain="[('active', '=', True)]"/>
                <filter name="disabled" string="Disabled" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_business_change_rule" model="ir.actions.act_window">
        <field name="name">Tracking Rules</field>
        <field name="res_model">business.change.rule</field>
        <field name="view_mode">list,form</field>
        <!-- disabled rules are listed too: enabling/disabling is done from this list -->
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a tracking rule</p>
            <p>Pick a model and the business fields whose changes should be kept.</p>
        </field>
    </record>
</odoo>
